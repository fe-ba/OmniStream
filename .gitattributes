# Normalize line endings for any text file git detects
* text=auto

# ---------------------------------------------------------------------
# Poster
# ---------------------------------------------------------------------
*.tex        text eol=lf
*.bib        text eol=lf
.latexmkrc   text eol=lf

# Diagrams are regenerated from the modeling tools, never merged by hand
*.svg        text eol=lf -merge
*.archimate  text eol=lf -merge
*.drawio     text eol=lf -merge

# ---------------------------------------------------------------------
# Java
# ---------------------------------------------------------------------
*.java        text eol=lf
*.properties  text eol=lf
*.xml         text eol=lf
*.gradle      text eol=lf
*.kts         text eol=lf
gradlew       text eol=lf
mvnw          text eol=lf
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.jar         binary

# ---------------------------------------------------------------------
# Scripts, config and docs
# ---------------------------------------------------------------------
.githooks/*  text eol=lf
*.sh         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf

# ---------------------------------------------------------------------
# Binaries
# ---------------------------------------------------------------------
*.pdf        binary
*.ttf        binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.rar        binary
*.zip        binary

# ---------------------------------------------------------------------
# Must stay LAST: it overrides "*.pdf binary" above (last match wins).
# PDF generated by CI; on conflict keep ours. Needs a local driver,
# once per clone:  git config merge.ours.driver true
# ---------------------------------------------------------------------
main.pdf     binary merge=ours
