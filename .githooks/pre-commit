#!/usr/bin/env bash
set -u

ROOT="$(git rev-parse --show-toplevel)"
POSTER="docs/architecture/empresarial"
cd "$ROOT" || exit 1

# Only build when the commit touches something that changes the poster PDF:
# .tex, .bib, .svg or .latexmkrc. Commits to src/, the rest of docs/, or
# only the models (.archimate, .drawio) go straight through.
if ! git diff --cached --name-only \
     | grep -qE "^${POSTER}/(.+\.(tex|bib|svg)|\.latexmkrc)$"; then
  exit 0
fi

cd "$POSTER" || exit 1

if ! command -v latexmk >/dev/null 2>&1; then
  echo "latexmk is not installed; skipping the local check."
  echo "The commit will still be validated by GitHub Actions."
  exit 0
fi

LOG="$(mktemp)"
echo "Building the poster with LuaLaTeX (the first run takes ~1 min)..."

if latexmk -pdflua -file-line-error -interaction=nonstopmode \
           -outdir=build main.tex >"$LOG" 2>&1; then
  echo "OK: the poster builds."
  rm -f "$LOG"
  exit 0
fi

echo
echo "ERROR: the poster does NOT build. Commit aborted."
echo "-------------------- errors ---------------------"
grep -m 8 -E "^(\./)?[^ ]+\.tex:[0-9]+:|^! " "$LOG" || tail -40 "$LOG"
echo "-------------------------------------------------"
echo "Full log: $LOG"
echo
echo "To skip the hook (not recommended): git commit --no-verify"
exit 1
