@startuml annex-OmniStream-Components-WithUseCases
' ============================================================
'  OmniStream - Component diagram (ANNEX, discarded variant)
'  Clean / hexagonal architecture (ports and adapters)
'
'  Layers:  Presentation -> Application (use cases) -> Domain -> Infrastructure
'  Dependency rule: everything points inwards.
'  The domain knows no concrete technology.
'
'  This is the 4-layer variant that was evaluated and discarded.
'  It reflects the design before the consistency review and is
'  kept only as a record of the alternative.
'
'  Line convention:
'    solid line    component -- port : PROVIDES / IMPLEMENTS it
'    arrow ..>     component -> port : CONSUMES it / depends on it
' ============================================================

' vertical layout: one layer per level
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam ArrowColor #666666
skinparam ArrowFontSize 10
skinparam PackageFontStyle bold
skinparam nodesep 55
skinparam ranksep 55

skinparam rectangle {
  BorderThickness 1.4
  BackgroundColor<<external>>    #F2F2F2
  BorderColor<<external>>        #888888
  BackgroundColor<<presentation>> #E8F4FD
  BorderColor<<presentation>>    #2E86AB
  BackgroundColor<<application>> #FDF2E0
  BorderColor<<application>>     #D98E04
  BackgroundColor<<domain>>      #FFF7E0
  BorderColor<<domain>>          #B8860B
  BackgroundColor<<driven>>      #E6F6E6
  BorderColor<<driven>>          #3E8E41
  BackgroundColor<<infra>>       #F7F7F7
  BorderColor<<infra>>           #999999
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #666666
  FontSize 11
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #2E86AB
  FontSize 11
}

' ============================================================
' 1. CLIENTS  (outside the system)
' ============================================================
rectangle "Clients" <<external>> {
  component "Browser"            as CliWeb
  component "Desktop app"        as CliDesk
  component "Mobile app"         as CliMobile
  component "Terminal / scripts" as CliCli
}

' ============================================================
' 2. PRESENTATION LAYER  (primary / driving adapters)
' ============================================================
rectangle "Presentation layer\n(primary / driving adapters)" <<presentation>> {
  component "Web UI adapter\n<<HTTP controller>>"    as AdWeb
  component "Desktop adapter\n<<local controller>>"  as AdDesk
  component "Mobile adapter\n<<mobile controller>>"  as AdMobile
  component "CLI adapter\n<<controller>>"            as AdCli
  component "REST API adapter\n<<controller>>"       as AdApi
}

' ============================================================
' 3. DRIVING PORTS  (provided by the application layer)
' ============================================================
interface "ICatalogManagement" as PIN_CAT
interface "ISearch"            as PIN_SEARCH
interface "IPlayback"          as PIN_PLAY
interface "IAccessControl"     as PIN_ACC
interface "ISync"              as PIN_SYNC

' ============================================================
' 4. APPLICATION LAYER  +  5. DOMAIN
' ============================================================
rectangle "Application layer  (use cases)" <<application>> {
  component "Catalog service\n<<use case>>\n..\ningestFile()\nreindexLibrary()\ndetectDuplicates()"     as UcCatalog
  component "Search service\n<<use case>>\n..\nsearchContent()\nfilterByCriteria()\nmanageCollections()" as UcSearch
  component "Playback service\n<<use case>>\n..\nopenSession()\nrequestStream()\nrecordProgress()"      as UcPlayback
  component "Access service\n<<use case>>\n..\nauthenticateUser()\nauthorizeResource()\nmanageRoles()"   as UcAccess
  component "Sync service\n<<use case>>\n..\nsyncChanges()\ncacheContent()"                            as UcSync
}

rectangle "Domain  (model and rules)" <<domain>> {
  component "CatalogIndex\n<<aggregate root>>"   as ModelCatalog
  component "MediaFile\n<<entity>>"              as ModelFile
  component "MetadataEntry\n<<value object>>"    as ModelMetadata
  component "Collection / Tag\n<<entity>>"       as ModelCollection
  component "User\n<<entity>>"                   as ModelUser
  component "Permission\n<<value object>>"       as ModelPermission
  component "PlaybackSession\n<<entity>>"        as ModelSession
  component "Domain policies\n<<rules>>"         as ModelPolicies
}

' ============================================================
' 5. DRIVEN PORTS  (needed by the application layer)
' ============================================================
interface "ICatalogRepository" as POUT_REPO
interface "IFileStorage"       as POUT_FS
interface "IMetadataExtractor" as POUT_META
interface "ITranscoder"        as POUT_TRANS
interface "IIdentityProvider"  as POUT_IDP
interface "IEventPublisher"    as POUT_PUB

' ============================================================
' 6. SECONDARY ADAPTERS  (driven)
' ============================================================
rectangle "Secondary adapters (driven)" <<driven>> {
  component "Persistence adapter\n<<SQLite / PostgreSQL>>"  as AdPersistence
  component "File storage adapter\n<<local FS / NAS / SMB>>" as AdFs
  component "Metadata adapter\n<<FFmpeg / ExifTool>>"       as AdMeta
  component "Transcoding adapter\n<<FFmpeg>>"               as AdTrans
  component "Identity adapter\n<<OIDC / local auth>>"       as AdIdp
  component "Event adapter\n<<in-memory bus>>"              as AdEvents
}

' ============================================================
' 7. INFRASTRUCTURE
' ============================================================
rectangle "Infrastructure" <<infra>> {
  database  "Database\nand index"        as DbIndex
  folder    "File library\n(NAS / disk)" as FsLibrary
  component "External\nidentity provider" as IdpExternal
}

' ============================================================
' CLIENTS -> PRESENTATION
' ============================================================
CliWeb    --> AdWeb
CliDesk   --> AdDesk
CliMobile --> AdMobile
CliCli    --> AdCli
AdWeb     --> AdApi : HTTP/JSON
AdDesk    --> AdApi : HTTP/IPC
AdMobile  --> AdApi : HTTP/JSON

' ============================================================
' PRESENTATION -> DRIVING PORTS  (consumes)
' ============================================================
AdApi    ..> PIN_CAT
AdApi    ..> PIN_SEARCH
AdApi    ..> PIN_PLAY
AdApi    ..> PIN_ACC
AdCli    ..> PIN_CAT
AdDesk   ..> PIN_SYNC
AdMobile ..> PIN_SYNC

' ============================================================
' APPLICATION LAYER -- DRIVING PORTS  (provides)
' ============================================================
UcCatalog  -up- PIN_CAT
UcSearch   -up- PIN_SEARCH
UcPlayback -up- PIN_PLAY
UcAccess   -up- PIN_ACC
UcSync     -up- PIN_SYNC

' ============================================================
' USE CASES -> DOMAIN
' ============================================================
UcCatalog  --> ModelCatalog
UcSearch   --> ModelCollection
UcPlayback --> ModelSession
UcAccess   --> ModelUser
UcSync     --> ModelCatalog

' --- relations inside the model ---
ModelCatalog  *-- ModelFile
ModelFile     *-- ModelMetadata
ModelCatalog  o-- ModelCollection
ModelUser     *-- ModelPermission
ModelSession  --> ModelFile
ModelPolicies ..> ModelCatalog    : validates
ModelPolicies ..> ModelPermission : validates

' ============================================================
' APPLICATION LAYER -> DRIVEN PORTS  (consumes)
' ============================================================
UcCatalog  ..> POUT_REPO
UcCatalog  ..> POUT_FS
UcCatalog  ..> POUT_META
UcCatalog  ..> POUT_PUB
UcSearch   ..> POUT_REPO
UcPlayback ..> POUT_FS
UcPlayback ..> POUT_TRANS
UcAccess   ..> POUT_IDP
UcSync     ..> POUT_PUB

' ============================================================
' ADAPTERS -- DRIVEN PORTS  (implements)
' ============================================================
AdPersistence -up- POUT_REPO
AdFs          -up- POUT_FS
AdMeta        -up- POUT_META
AdTrans       -up- POUT_TRANS
AdIdp         -up- POUT_IDP
AdEvents      -up- POUT_PUB

' ============================================================
' ADAPTERS -> INFRASTRUCTURE
' ============================================================
AdPersistence --> DbIndex
AdFs          --> FsLibrary
AdMeta        --> FsLibrary
AdTrans       --> FsLibrary
AdIdp         --> IdpExternal : optional

' ============================================================
' NOTES
' ============================================================
note left of PIN_CAT
  **Driving ports**
  PROVIDED by the application layer (solid line).
  CONSUMED by the presentation layer (dashed arrow).
end note

note left of POUT_REPO
  **Driven ports**
  NEEDED by the application layer (dashed arrow).
  IMPLEMENTED by the infrastructure (solid line).
  This is where the dependency is inverted: swapping
  SQLite for PostgreSQL does not touch the domain.
end note

@enduml
