@startuml OmniStream-Componentes
' ============================================================
'  OmniStream - Diagrama de componentes
'  Arquitectura limpia / hexagonal (puertos y adaptadores)
'
'  Capas:  Presentacion  ->  Dominio  ->  Infraestructura
'  Regla de dependencia: todo apunta hacia adentro.
'  El dominio no conoce ninguna tecnologia concreta.
'  La composicion raiz no es una capa: crea y conecta todo.
'
'  Detalle de cada parte:
'   - Modelo:            OmniStream-Dominio-Modelo.puml
'   - Servicios:         OmniStream-Servicios.puml
'   - Puertos/adaptad.:  OmniStream-PuertosAdaptadores.puml
'
'  Convencion de lineas:
'    linea solida  componente -- puerto : lo PROVEE / lo IMPLEMENTA
'    flecha ..>    componente -> puerto : lo CONSUME / depende de el
'    borde punteado: fuera del alcance de la version 1.0 (ADR 0009)
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam ArrowColor #666666
skinparam ArrowFontSize 10
skinparam PackageFontStyle bold
skinparam nodesep 45
skinparam ranksep 55

skinparam rectangle {
  BorderThickness 1.4
  BackgroundColor<<externo>>  #F2F2F2
  BorderColor<<externo>>      #888888
  BackgroundColor<<present>>  #E8F4FD
  BorderColor<<present>>      #2E86AB
  BackgroundColor<<dominio>>  #FFF7E0
  BorderColor<<dominio>>      #B8860B
  BackgroundColor<<servicio>> #FFF2CC
  BorderColor<<servicio>>     #B8860B
  BackgroundColor<<modelo>>   #FDF6E3
  BorderColor<<modelo>>       #C9A227
  BackgroundColor<<driven>>   #E6F6E6
  BorderColor<<driven>>       #3E8E41
  BackgroundColor<<infra>>    #F7F7F7
  BorderColor<<infra>>        #999999
  BackgroundColor<<arranque>> #FFFDE7
  BorderColor<<arranque>>     #B8A848
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #666666
  FontSize 11
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #2E86AB
  FontSize 11
}

' ============================================================
' 1. CLIENTES  (fuera del sistema)
' ============================================================
rectangle "Clientes" <<externo>> {
  component "Navegador"          as CliWeb
  component "App movil"          as CliMobile #FFFFFF;line.dashed;line:999999
  component "Terminal / scripts" as CliCli
}

' ============================================================
' 2. CAPA DE PRESENTACION  (adaptadores primarios / driving)
' ============================================================
rectangle "Capa de presentacion\n(adaptadores primarios / driving)" <<present>> {
  component "Adaptador Web UI\n<<Javalin>>"                     as AdWeb
  component "Adaptador CLI\n<<controlador>>"                    as AdCli
  component "Adaptador API REST\n<<Javalin>>"                   as AdApi
  component "Adaptador Programador\n<<tareas programadas>>"     as AdProg
}

' ============================================================
' 3. PUERTOS DE ENTRADA  (los provee el dominio)
' ============================================================
rectangle "Puertos de entrada" <<dominio>> {
  interface "IGestionCatalogo" as PIN_CAT
  interface "IBusqueda"        as PIN_BUS
  interface "IReproduccion"    as PIN_REP
  interface "IControlAcceso"   as PIN_ACC
  interface "ISincronizacion"  as PIN_SIN
  interface "IDespachoEventos" as PIN_DES
  interface "IHistorialAuditoria" as PIN_AUD
  interface "IFlujoCatalogo"      as PIN_FLU
  interface "IEdicionTexto"       as PIN_TXT
  interface "IGestionReglas"   as PIN_REG #FFFFFF;line.dashed;line:999999
}

' ============================================================
' 4. DOMINIO
' ============================================================
rectangle "Dominio" <<dominio>> {

  rectangle "Servicios de dominio" <<servicio>> {
    component "Servicio de Catalogo\n..\ningestarArchivo()\nsubirArchivo()\nreindexarBiblioteca()"          as SvCat
    component "Servicio de Busqueda\n..\nbuscarContenido()\nfiltrarPorCriterios()\ngestionarColecciones()" as SvBus
    component "Servicio de Reproduccion\n..\nabrirSesion()\nsolicitarStream()\nregistrarProgreso()"        as SvRep
    component "Servicio de Acceso\n..\nautenticarUsuario()\ncrearUsuario()\ncompartirColeccion()"          as SvAcc
    component "Servicio de Sincronizacion\n..\nsincronizarCambios()\ncachearContenido()"                    as SvSin
    component "Servicio de Despacho de Eventos\n..\npublicarPendientes()"                                   as SvDes
    component "Observador de Sincronizacion\n<<observer>>\n..\nalCambiarCatalogo()"                         as SvObs
    component "Servicio de Clasificacion\n..\ncrearRegla()\nreclasificarBiblioteca()"                      as SvCla #FFFFFF;line.dashed;line:999999
    component "Servicio de Auditoria\n..\nhistorial()"                                         as SvAud
    component "Servicio de Flujo del Catalogo\n..\nseguir()"                                  as SvFlu
    component "Servicio de Edicion de Texto\n..\nabrir()\nguardar()"                         as SvTxt
    component "Decoradores de auditoria\n<<decorator>>\n..\nregistran cada cambio"           as DecAud
  }

  rectangle "Modelo de dominio" <<modelo>> {
    component "CatalogoIndice\n<<aggregate root>>"       as EnCatalogo
    component "ArchivoMultimedia\n<<entity>>"            as EnArchivo
    component "Metadato\n<<value object>>"               as EnMeta
    component "Coleccion\n<<entity>>"                    as EnColeccion
    component "Etiqueta\n<<value object>>"               as EnEtiqueta
    component "Reglas de clasificacion\n<<strategy>>"     as EnClasif
    component "Usuario\n<<aggregate root>>"              as EnUsuario
    component "Permiso\n<<value object>>"                as EnPermiso
    component "EnlaceCompartido\n<<aggregate root>>"     as EnEnlace
    component "SesionReproduccion\n<<aggregate root>>"   as EnSesion
    component "Eventos de dominio\n<<event>>"            as EnEventos
    component "Politicas de dominio\n<<policy>>"         as EnReglas
    component "EntradaAuditoria\n<<value object>>"     as EnAuditoria
  }
}

' ============================================================
' 5. PUERTOS DE SALIDA  (los define el dominio)
' ============================================================
rectangle "Puertos de salida" <<dominio>> {
  interface "IRepositorioCatalogo"    as POUT_REPO
  interface "IRepositorioSesiones"    as POUT_SES
  interface "IRepositorioUsuarios"    as POUT_USR
  interface "IRepositorioEnlaces"     as POUT_ENL
  interface "IRegistroCambios"        as POUT_CAMB
  interface "IRepositorioOutbox"      as POUT_OUT
  interface "IUnidadDeTrabajo"        as POUT_UOW
  interface "IRegistroAuditoria"      as POUT_AUD
  interface "IRepositorioTokens"      as POUT_TOK
  interface "IAlmacenamientoArchivos" as POUT_FS
  interface "IExtractorMetadatos"     as POUT_META
  interface "ITranscodificador"       as POUT_TRANS
  interface "IProveedorIdentidad"     as POUT_IDP
  interface "IRegistroCredenciales"   as POUT_CRED
  interface "IRespaldoDatos"          as POUT_RESP
  interface "IRepositorioConfiguracion" as POUT_CONF
  interface "IRepositorioReglas"      as POUT_REG #FFFFFF;line.dashed;line:999999
  interface "IPublicadorEventos"      as POUT_PUB
  interface "ISuscriptorEventos"      as POUT_SUS
}

' ============================================================
' 6. ADAPTADORES SECUNDARIOS  (driven)
' ============================================================
rectangle "Infraestructura\n(adaptadores secundarios / driven)" <<driven>> {
  component "Adaptador de persistencia\n<<JDBC: SQLite / PostgreSQL>>" as AdRepo
  component "Adaptador de archivos\n<<FS local / NAS / SMB>>"         as AdFs
  component "Adaptador de metadatos\n<<FFprobe / ExifTool>>"          as AdMeta
  component "Adaptador de transcodificacion\n<<FFmpeg>>"              as AdTrans
  component "Adaptador de identidad\n<<local / OIDC>>"                as AdIdp
  component "Adaptador de tokens\n<<en memoria>>"                     as AdTok
  component "Adaptador de eventos\n<<bus en memoria>>"                as AdEvt
}

' ============================================================
' 7. RECURSOS EXTERNOS
' ============================================================
rectangle "Recursos externos" <<infra>> {
  database  "Base de datos\ne indice"               as DbIndice
  folder    "Biblioteca de archivos\n(NAS / disco)" as FsBiblioteca
  component "Proveedor de identidad\nexterno"       as IdpExterno #FFFFFF;line.dashed;line:999999
}

' ============================================================
' 8. ARRANQUE  (fuera de las capas)
' ============================================================
rectangle "Arranque" <<arranque>> {
  component "Composicion raiz\n<<composition root>>\n..\nfabrica Local / Servidor" as Composicion
}

' ============================================================
' CLIENTES -> PRESENTACION
' ============================================================
CliWeb    --> AdWeb
CliWeb    --> AdApi : HTTP/JSON
CliMobile ..> AdApi : HTTP/JSON
CliCli    --> AdCli

' ============================================================
' PRESENTACION -> PUERTOS DE ENTRADA  (consume)
' ============================================================
AdApi    ..> PIN_CAT
AdApi    ..> PIN_BUS
AdApi    ..> PIN_REP
AdApi    ..> PIN_ACC
AdApi    ..> PIN_SIN
AdApi    ..> PIN_REG
AdApi    ..> PIN_AUD
AdApi    ..> PIN_FLU : cambios en vivo (SSE)
AdCli    ..> PIN_CAT
AdProg   ..> PIN_CAT : reindexar / respaldar
AdProg   ..> PIN_DES : sincronizar

' ============================================================
' DOMINIO -- PUERTOS DE ENTRADA  (provee)
' ============================================================
SvCat -up- PIN_CAT
SvBus -up- PIN_BUS
SvRep -up- PIN_REP
SvAcc -up- PIN_ACC
SvSin -up- PIN_SIN
SvDes -up- PIN_DES
SvCla -up- PIN_REG
SvAud -up- PIN_AUD
SvFlu -up- PIN_FLU
SvTxt -up- PIN_TXT

' ============================================================
' SERVICIOS -> MODELO DE DOMINIO
' ============================================================
SvCat --> EnCatalogo
SvBus --> EnCatalogo
SvRep --> EnSesion
SvAcc --> EnUsuario
SvAcc --> EnEnlace
SvObs --> EnEventos : recibe
SvDes --> EnEventos : publica
SvCat --> EnClasif : clasifica al ingerir
SvCla --> EnClasif
SvAud --> EnAuditoria
SvTxt --> EnCatalogo : reemplaza contenido
DecAud --> EnAuditoria : registra
DecAud ..> SvAcc : envuelve
DecAud ..> SvCat : envuelve
DecAud ..> SvBus : envuelve
DecAud ..> SvSin : envuelve

' --- relaciones internas del modelo ---
EnCatalogo *-- EnArchivo
EnCatalogo *-- EnColeccion
EnArchivo  *-- EnMeta
EnArchivo  *-- EnEtiqueta
EnClasif   ..> EnEtiqueta : asigna
EnUsuario  *-- EnPermiso
EnCatalogo --> EnEventos : registra
EnSesion   ..> EnArchivo : por id
EnEnlace   ..> EnColeccion : por id
EnReglas   ..> EnCatalogo : valida
EnReglas   ..> EnPermiso  : valida

' ============================================================
' DOMINIO -> PUERTOS DE SALIDA  (consume)
' ============================================================
SvCat ..> POUT_REPO
SvCat ..> POUT_SES
SvCat ..> POUT_FS
SvCat ..> POUT_META
SvCat ..> POUT_RESP
SvCat ..> POUT_CONF
SvBus ..> POUT_REPO
SvRep ..> POUT_SES
SvRep ..> POUT_REPO
SvRep ..> POUT_FS
SvRep ..> POUT_TRANS
SvAcc ..> POUT_USR
SvAcc ..> POUT_IDP
SvAcc ..> POUT_CRED
SvAcc ..> POUT_TOK
SvAcc ..> POUT_ENL
SvAcc ..> POUT_UOW
SvAcc ..> POUT_REPO
SvSin ..> POUT_CAMB
SvSin ..> POUT_REPO
SvSin ..> POUT_FS
SvObs ..> POUT_CAMB
SvDes ..> POUT_OUT
SvDes ..> POUT_PUB
SvCla ..> POUT_REG
SvCla ..> POUT_REPO
SvAud ..> POUT_AUD
SvFlu ..> POUT_SUS
SvFlu ..> POUT_REPO
SvTxt ..> POUT_REPO
SvTxt ..> POUT_FS
SvTxt ..> POUT_UOW
DecAud ..> POUT_AUD
DecAud ..> POUT_UOW

' ============================================================
' ADAPTADORES -- PUERTOS DE SALIDA  (implementa)
' ============================================================
AdRepo  -up- POUT_REPO
AdRepo  -up- POUT_SES
AdRepo  -up- POUT_USR
AdRepo  -up- POUT_ENL
AdRepo  -up- POUT_CAMB
AdRepo  -up- POUT_OUT
AdRepo  -up- POUT_UOW
AdRepo  -up- POUT_AUD
AdRepo  -up- POUT_RESP
AdRepo  -up- POUT_CONF
AdRepo  -up- POUT_REG
AdFs    -up- POUT_FS
AdMeta  -up- POUT_META
AdTrans -up- POUT_TRANS
AdIdp   -up- POUT_IDP
AdIdp   -up- POUT_CRED
AdTok   -up- POUT_TOK
AdEvt   -up- POUT_PUB
AdEvt   -up- POUT_SUS

' El bus avisa a los observadores registrados
AdEvt ..> SvObs : notifica (IObservadorCatalogo)

' ============================================================
' ADAPTADORES -> RECURSOS EXTERNOS
' ============================================================
AdRepo  --> DbIndice
AdIdp   --> DbIndice : credenciales locales
AdFs    --> FsBiblioteca
AdMeta  --> FsBiblioteca
AdTrans --> FsBiblioteca
AdIdp   ..> IdpExterno : opcional (OIDC)

' ============================================================
' ARRANQUE -> CAPAS
' ============================================================
Composicion ..> POUT_SUS : registra observadores

note right of Composicion
  Crea los adaptadores con la fabrica del perfil
  (Abstract Factory: Local o Servidor), arma la
  cadena de ingesta, crea los servicios y los
  adaptadores primarios y suscribe el observador.
  No es una capa: nadie depende de ella.
end note

' ============================================================
' NOTAS
' ============================================================
note right of CliMobile
  No hay app de escritorio aparte: es el
  servidor en perfil local, usado desde el
  navegador (ADR 0010). La app movil queda
  para despues de la version 1.0 y usara el
  API REST, que ya expone la sincronizacion.
  En la 1.0 no entran OIDC ni NAS: el
  adaptador de identidad es solo local y el
  de archivos solo disco local (ADR 0009).
end note

note left of PIN_CAT
  **Puertos de entrada (driving)**
  Los PROVEE el dominio (linea solida).
  Los CONSUME la presentacion (flecha punteada).
end note

note left of POUT_REPO
  **Puertos de salida (driven)**
  Los NECESITA el dominio (flecha punteada).
  Los IMPLEMENTA la infraestructura (linea solida).
  Aqui se invierte la dependencia: cambiar SQLite
  por PostgreSQL no toca el dominio.
  Todos los servicios salvo el de despacho usan
  IRepositorioUsuarios a traves de su clase base
  de autorizacion; solo se dibuja la de Acceso.
end note

@enduml
