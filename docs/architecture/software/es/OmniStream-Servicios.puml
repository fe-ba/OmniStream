    - estrategiasStream : List<EstrategiaStream>
    __
    + abrirSesion(u : UsuarioId, id : ElementoId) : InstantaneaSesion
    + reanudarDesdeUltimaPosicion(u : UsuarioId, id : ElementoId) : InstantaneaSesion
    + solicitarStream(u : UsuarioId, s : SesionId, p : PerfilStream) : FlujoMultimedia
    + registrarProgreso(u : UsuarioId, s : SesionId, pos : Duration) : void
    + pausarSesion(u : UsuarioId, s : SesionId) : void
    + reanudarSesion(u : UsuarioId, s : SesionId) : void
    + finalizarSesion(u : UsuarioId, s : SesionId) : void
    - seleccionarStream(a : InstantaneaArchivo, p : PerfilStream) : EstrategiaStream
  }

  interface EstrategiaStream <<strategy>> #E4F4E4;line:6FA86F {
    + soporta(a : InstantaneaArchivo, p : PerfilStream) : boolean
    + generarFlujo(a : InstantaneaArchivo, p : PerfilStream, pos : Duration) : FlujoMultimedia
  }

  class StreamDirecto <<strategy>> {
    - almacenamiento : IAlmacenamientoArchivos
    __
    + soporta(a : InstantaneaArchivo, p : PerfilStream) : boolean
    + generarFlujo(a : InstantaneaArchivo, p : PerfilStream, pos : Duration) : FlujoMultimedia
  }

  class StreamTranscodificado <<strategy>> {
    - transcodificador : ITranscodificador
    __
    + soporta(a : InstantaneaArchivo, p : PerfilStream) : boolean
    + generarFlujo(a : InstantaneaArchivo, p : PerfilStream, pos : Duration) : FlujoMultimedia
  }

  note right of EstrategiaStream
    **Patron Strategy (stream):**
    StreamDirecto lee el archivo tal cual (direct play);
    StreamTranscodificado lo convierte bajo demanda.
  end note
}

' ============================================================
' MODELO DE DOMINIO REFERENCIADO
' ============================================================
