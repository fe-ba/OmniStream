' ============================================================
' SINCRONIZACION Y EVENTOS
' ============================================================
package "Sincronizacion y eventos" {

  class ServicioSincronizacion <<domain service>> {
    - registroCambios : IRegistroCambios
    - repositorioCatalogo : IRepositorioCatalogo
    - almacenamiento : IAlmacenamientoArchivos
    __
    + sincronizarCambios(u : UsuarioId, desde : Instant) : DeltaSincronizacion
    + cachearContenido(u : UsuarioId, id : ElementoId) : PaqueteOffline
    + hayCambiosPendientes(u : UsuarioId, desde : Instant) : boolean
    - empaquetar(a : InstantaneaArchivo) : PaqueteOffline
    - filtrarVisibles(u : Usuario, d : DeltaSincronizacion) : DeltaSincronizacion
  }

  class ServicioDespachoEventos <<domain service>> {
    - outbox : IRepositorioOutbox
    - publicador : IPublicadorEventos
    __
    + publicarPendientes(limite : int) : int
  }

  interface IObservadorCatalogo <<observer>> #E4F4E4;line:6FA86F {
    + alCambiarCatalogo(e : EventoDominio) : void
  }

  class ObservadorSincronizacion <<observer>> {
    - registroCambios : IRegistroCambios
    __
    + alCambiarCatalogo(e : EventoDominio) : void
  }

  note bottom of ObservadorSincronizacion
    **Patron Observer:**
    el bus de eventos (AdaptadorBusEventos) es el unico
    dueno de la lista de observadores. ComposicionRaiz
    registra este observador al arrancar. Por cada
    EventoCatalogo escribe en IRegistroCambios, de donde
    lee ServicioSincronizacion. Los dos no se conocen.
  end note
}

' ============================================================
' HISTORIAL DE AUDITORIA (Decorator, ADR 0025)
' ============================================================
package "Historial de auditoria" {

  class ServicioAuditoria <<domain service>> {
    - registroAuditoria : IRegistroAuditoria
    __
    + historial(u : UsuarioId, q : ConsultaAuditoria) : List<EntradaAuditoria>
  }

  abstract class DecoradorAuditoria <<decorator>> {
    # registroAuditoria : IRegistroAuditoria
    # unidadDeTrabajo : IUnidadDeTrabajo
    # reloj : Clock
    __
    # auditado(llamada : Supplier<T>, describir : Function<T, Optional<EntradaAuditoria>>) : T
    # auditado(llamada : Runnable, describir : Supplier<EntradaAuditoria>) : void
    # anotar(e : EntradaAuditoria) : void
    # entrada(actor : UsuarioId, accion : AccionAuditoria) : EntradaAuditoria
  }

  class ControlAccesoAuditado <<decorator>> {
    - delegado : IControlAcceso
    - repositorioUsuarios : IRepositorioUsuarios
  }

  class GestionCatalogoAuditada <<decorator>> {
    - delegado : IGestionCatalogo
    - repositorioCatalogo : IRepositorioCatalogo
  }

  class BusquedaAuditada <<decorator>> {
    - delegado : IBusqueda
  }

  class SincronizacionAuditada <<decorator>> {
    - delegado : ISincronizacion
  }

  note bottom of DecoradorAuditoria
    **Patron Decorator (auditoria):** cada decorador
    implementa el mismo puerto de entrada que el servicio
    que envuelve y le pasa cada llamada. Si la llamada
    cambia algo, registra una EntradaAuditoria en la misma
    unidad de trabajo; si la llamada lanza, no registra
    nada. Las lecturas pasan sin tocarse.
    ComposicionRaiz entrega los decoradores a los
    adaptadores primarios: los servicios no se enteran.
  end note

  note bottom of ServicioAuditoria
    Lee el historial. Los administradores lo leen
    completo; los demas, solo la historia de un archivo
    o coleccion que pueden ver.
  end note
}

