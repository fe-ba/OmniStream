    + explorarBiblioteca(u : UsuarioId) : List<InstantaneaElemento>
    + explorarBiblioteca(u : UsuarioId, col : ElementoId) : List<InstantaneaElemento>
    + gestionarColecciones(u : UsuarioId, cmd : ComandoColeccion) : InstantaneaColeccion
    + etiquetarArchivo(u : UsuarioId, id : ElementoId, e : Etiqueta) : void
    - ordenarResultados(l : List<InstantaneaArchivo>, c : CriterioBusqueda) : List<InstantaneaArchivo>
