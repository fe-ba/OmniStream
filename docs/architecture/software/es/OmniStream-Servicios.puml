@startuml OmniStream-Servicios
' ============================================================
'  OmniStream - Diagrama de clases
'  Capa de DOMINIO, vista de SERVICIOS
'  Modulo: omnistream-domain
'
'  Servicios de dominio que implementan los puertos de entrada,
'  los patrones que usan por dentro y los DTOs de los puertos.
'
'  Convenciones:
'   - Cada servicio implementa un puerto de entrada (ver nota).
'   - Las dependencias hacia puertos de salida aparecen como
'     atributos tipados con la interfaz; las lineas hacia esos
'     puertos estan en OmniStream-PuertosAdaptadores.puml.
'   - Los tipos del modelo (Usuario, CatalogoIndice, ...) se
'     muestran sin miembros: estan en OmniStream-Dominio-Modelo.puml.
'   - Los servicios leen el estado de una entidad a traves de su
'     instantanea y los puertos de entrada responden con
'     instantaneas, nunca con entidades (ADR 0011).
'   - El reloj (java.time.Clock) se inyecta: los servicios pasan
'     el instante a los metodos del dominio que lo necesitan.
'   - Borde punteado: fuera del alcance de la version 1.0 (ADR 0009).
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam ArrowFontSize 10
skinparam PackageFontStyle bold
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
hide empty members
' Los paquetes son solo agrupaciones visuales, no espacios de nombres.
set separator none

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #666666
  FontSize 12
  AttributeFontSize 11
  BackgroundColor<<domain service>>      #FCE8B4
  BorderColor<<domain service>>          #B89748
  BackgroundColor<<service base>>        #ECE4F8
  BorderColor<<service base>>            #9673A6
  BackgroundColor<<chain handler>>       #ECE4F8
  BorderColor<<chain handler>>           #9673A6
  BackgroundColor<<handler>>             #FCF4E0
  BorderColor<<handler>>                 #C4A868
  BackgroundColor<<strategy>>            #FCF4E0
  BorderColor<<strategy>>                #C4A868
  BackgroundColor<<observer>>            #FCF4E0
  BorderColor<<observer>>                #C4A868
  BackgroundColor<<dto>>                 #FCF4E0
  BorderColor<<dto>>                     #C4A868
  BackgroundColor<<command>>             #FCF4E0
  BorderColor<<command>>                 #C4A868
  BackgroundColor<<decorator>>           #E4F4E4
  BorderColor<<decorator>>               #6FA86F
  BackgroundColor<<event>>               #ECE4F8
  BorderColor<<event>>                   #9673A6
  BackgroundColor<<aggregate root>>      #FFE8B5
  BorderColor<<aggregate root>>          #B8860B
  BackgroundColor<<policy>>              #E6F6E6
  BorderColor<<policy>>                  #3E8E41
  BackgroundColor<<driven port>>         #F3E5F5
  BorderColor<<driven port>>             #8E44AD
}
skinparam package {
  BackgroundColor #FCFCFC
