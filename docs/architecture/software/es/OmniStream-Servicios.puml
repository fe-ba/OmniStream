  class SesionReproduccion <<aggregate root>>
  abstract class EventoDominio <<event>>
  abstract class EventoCatalogo <<event>>
  class EntradaAuditoria <<value object>>
}

' ============================================================
' DTOS Y COMANDOS DE LOS PUERTOS
' ============================================================
package "DTOs y comandos de los puertos" {

  abstract class Credenciales <<dto>> #ECE4F8;line:9673A6 {
    + proveedor : String
  }

  class CredencialesLocales <<dto>> {
