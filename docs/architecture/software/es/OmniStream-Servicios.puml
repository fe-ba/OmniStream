  BackgroundColor #FEFFDD
  BorderColor #B8A848
  FontSize 11
}

' ============================================================
' BASE DE AUTORIZACION
' ============================================================
package "Base de autorizacion" {

  abstract class ServicioAutorizado <<service base>> {
    # repositorioUsuarios : IRepositorioUsuarios
    # politicaAcceso : PoliticaAcceso
    # reloj : Clock
    __
    # cargarUsuario(u : UsuarioId) : Usuario
    # verificarAcceso(u : UsuarioId, r : ElementoId, acc : TipoAcceso) : void
    # exigirAdministrador(admin : UsuarioId) : void
  }

  note top of ServicioAutorizado
    Base comun de los servicios que reciben un UsuarioId.
    Carga el Usuario con IRepositorioUsuarios y le pregunta
    a PoliticaAcceso. Depende de abstracciones, no de otro
    servicio. Si se niega el acceso lanza AccesoDenegado.
  end note
}

' ============================================================
' ACCESO Y SEGURIDAD
' ============================================================
package "Acceso y seguridad" {

  class ServicioAcceso <<domain service>> {
    - proveedores : List<IProveedorIdentidad>
    - registroCredenciales : IRegistroCredenciales
    - repositorioTokens : IRepositorioTokens
    - repositorioEnlaces : IRepositorioEnlaces
    - repositorioCatalogo : IRepositorioCatalogo
    - unidadDeTrabajo : IUnidadDeTrabajo
    __
    + autenticarUsuario(c : Credenciales) : TokenSesion
    + validarToken(valor : String) : Optional<TokenSesion>
    + cerrarSesion(valor : String) : void
    + accederConEnlace(enlace : String) : TokenSesion
    + autorizarRecurso(u : UsuarioId, r : ElementoId, acc : TipoAcceso) : boolean
    + compartirColeccion(u : UsuarioId, col : ElementoId, niv : NivelPermiso, vigencia : Duration) : InstantaneaEnlace
    + crearUsuario(admin : UsuarioId, nombreUsuario : String, clave : String, rol : Rol) : UsuarioId
    + gestionarRoles(admin : UsuarioId, obj : UsuarioId, rol : Rol) : void
    + otorgarPermiso(otorgante : UsuarioId, u : UsuarioId, p : Permiso) : void
    + revocarPermiso(otorgante : UsuarioId, u : UsuarioId, p : Permiso) : void
    + desactivarUsuario(admin : UsuarioId, u : UsuarioId) : void
    + listarUsuarios(admin : UsuarioId) : List<InstantaneaUsuario>
    + buscarUsuario(u : UsuarioId, nombreUsuario : String) : UsuarioId
    + accesoA(u : UsuarioId, recurso : ElementoId) : List<ConcesionAcceso>
    - seleccionarProveedor(c : Credenciales) : IProveedorIdentidad
    - emitirToken(u : Usuario) : TokenSesion
    - nivelHeredado(u : Usuario, r : ElementoId) : Optional<NivelPermiso>
  }

  note right of ServicioAcceso
    **Delegacion (ADR 0024):** un administrador
    otorga cualquier cosa; quien administra un recurso
    (directamente o por una coleccion) otorga
    READ o WRITE sobre el. PoliticaAcceso.puedeDelegar
    decide; nivelHeredado recorre las colecciones.
  end note

  interface IProveedorIdentidad <<driven port>>

  note bottom of IProveedorIdentidad
    **Patron Strategy (identidad):**
    el puerto es la estrategia. seleccionarProveedor()
    usa el primero que soporte las credenciales.
    Implementaciones: AdaptadorIdentidadLocal y
    AdaptadorIdentidadOIDC (ver puertos y adaptadores).
  end note
}

' ============================================================
' CATALOGO E INGESTA
' ============================================================
package "Catalogo e ingesta" {

  class ServicioCatalogo <<domain service>> {
    - cadenaIngesta : PasoIngesta
    - repositorioCatalogo : IRepositorioCatalogo
    - repositorioSesiones : IRepositorioSesiones
    - almacenamiento : IAlmacenamientoArchivos
    - respaldoDatos : IRespaldoDatos
    - repositorioConfiguracion : IRepositorioConfiguracion
    - politicaDeduplicacion : PoliticaDeduplicacion
    __
    + ingestarArchivo(u : UsuarioId, ruta : Path) : ResultadoIngesta
    + subirArchivo(u : UsuarioId, nombreArchivo : String, datos : InputStream) : ResultadoIngesta
    + reindexarBiblioteca(u : UsuarioId, raiz : Path) : int
    + detectarDuplicados(u : UsuarioId) : List<InstantaneaArchivo>
    + editarMetadato(u : UsuarioId, id : ElementoId, clave : String, valor : String) : void
    + eliminarArchivo(u : UsuarioId, id : ElementoId) : void
    + respaldarCatalogo(admin : UsuarioId, destino : Path) : Path
    + configurarRutaBiblioteca(admin : UsuarioId, ruta : Path) : void
    + monitorearEstadoServidor(admin : UsuarioId) : EstadoServidor
    - ingestar(ctx : ContextoIngesta) : ResultadoIngesta
  }

  abstract class PasoIngesta <<chain handler>> {
    - siguiente : PasoIngesta
    __
    + encadenar(sig : PasoIngesta) : PasoIngesta
    + ejecutar(ctx : ContextoIngesta) : ResultadoIngesta
    # {abstract} procesar(ctx : ContextoIngesta) : boolean
  }

  class PasoExtraccion <<handler>> {
    - almacenamiento : IAlmacenamientoArchivos
    - extractor : IExtractorMetadatos
    - reloj : Clock
    __
    # procesar(ctx : ContextoIngesta) : boolean
  }

  class PasoDuplicados <<handler>> {
    - politica : PoliticaDeduplicacion
    __
    # procesar(ctx : ContextoIngesta) : boolean
  }

  class PasoClasificacion <<handler>> {
    - reglas : List<ReglaClasificacion>
    __
    # procesar(ctx : ContextoIngesta) : boolean
  }

  class PasoIndexacion <<handler>> {
    # procesar(ctx : ContextoIngesta) : boolean
  }

  note left of PasoIngesta
    **Patron Chain of Responsibility:**
    Extraccion -> Duplicados -> Clasificacion -> Indexacion.
    ejecutar() llama a procesar() y, si devuelve
    true, pasa al siguiente (Template Method).
    PasoExtraccion crea el ArchivoMultimedia con su
    huella y metadatos; PasoDuplicados corta la cadena
    si la politica dice RECHAZAR; PasoClasificacion deja
    en el contexto lo que deciden las reglas;
    PasoIndexacion llama a CatalogoIndice.ingestar() y
    aplicarClasificacion(). La cadena la arma
    ComposicionRaiz.
  end note
}

' ============================================================
' CLASIFICACION AUTOMATICA   (ADR 0016)
' ============================================================
package "Clasificacion automatica" {

  interface ReglaClasificacion <<strategy>> #E4F4E4;line:6FA86F {
    + aplica(a : InstantaneaArchivo) : boolean
    + clasificar(a : InstantaneaArchivo) : Clasificacion
  }

  class ReglaPorTipo <<strategy>> {
    + aplica(a : InstantaneaArchivo) : boolean
    + clasificar(a : InstantaneaArchivo) : Clasificacion
  }

  class ReglaPorFecha <<strategy>> {
    + aplica(a : InstantaneaArchivo) : boolean
    + clasificar(a : InstantaneaArchivo) : Clasificacion
  }

  class ReglasDelUsuario <<strategy>> #FCF4E0;line.dashed;line:999999 {
    - repositorioReglas : IRepositorioReglas
    __
    + aplica(a : InstantaneaArchivo) : boolean
    + clasificar(a : InstantaneaArchivo) : Clasificacion
  }

  class ServicioClasificacion <<domain service>> #FCE8B4;line.dashed;line:999999 {
    - repositorioReglas : IRepositorioReglas
    - repositorioCatalogo : IRepositorioCatalogo
    - reglas : List<ReglaClasificacion>
    __
    + crearRegla(admin : UsuarioId, c : CriterioClasificacion) : void
    + eliminarRegla(admin : UsuarioId, nombre : String) : void
    + listarReglas(admin : UsuarioId) : List<CriterioClasificacion>
    + reclasificarBiblioteca(admin : UsuarioId) : int
  }

  note right of ReglaClasificacion
    **Patron Strategy (clasificacion, ADR 0016):**
    cada regla decide si aplica al archivo y que
    etiquetas o colecciones le corresponden;
    PasoClasificacion combina el resultado de todas.
    En la 1.0 hay reglas fijas por tipo de medio y por
    fecha. ReglasDelUsuario (2.0) aplica los criterios
    que define el administrador: se agrega a la lista
    sin cambiar la cadena ni las otras reglas.
  end note
}

