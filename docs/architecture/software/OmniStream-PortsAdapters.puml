package "Secondary adapters (infrastructure)" #FCE4D6 {
   abstract class JdbcPersistenceAdapter <<secondary adapter>> {
     # catalogMapper : CatalogIndexMapper
     # mediaFileMapper : MediaFileMapper
     # metadataMapper : MetadataEntryMapper
     # collectionMapper : CollectionMapper
     # userMapper : UserMapper
     # permissionMapper : PermissionMapper
     # identityMapper : LinkedIdentityMapper
     # sessionMapper : SessionMapper
     # sharedLinkMapper : SharedLinkMapper
     # eventMapper : EventMapper
     # auditMapper : AuditEntryMapper
     # {abstract} connection() : Connection
     # {abstract} dumpDatabase(destination : Path) : Path
     - assembleCatalog(c : Connection) : CatalogSnapshot
     - writeCatalog(c : Connection, i : CatalogSnapshot, events : List<CatalogEvent>) : void
   }
   class SqlitePersistenceAdapter <<secondary adapter>> {
     - databasePath : Path
     # connection() : Connection
     # dumpDatabase(destination : Path) : Path
   }
   class PostgreSqlPersistenceAdapter <<secondary adapter>> {
     - url : URI
     - pool : DataSource
     # connection() : Connection
     # dumpDatabase(destination : Path) : Path
   }
   class LocalFileStorageAdapter <<secondary adapter>> {
     - allowedRoot : Path
     + read(path : Path) : InputStream
     + write(path : Path, data : InputStream) : void
     + delete(path : Path) : void
     + exists(path : Path) : boolean
     + list(root : Path) : List<Path>
     + computeFingerprint(path : Path) : Fingerprint
     + copy(source : Path, destination : Path) : Path
     + freeSpace() : long
     - ensureWithinRoot(path : Path) : void
   }
   class NetworkFileStorageAdapter <<secondary adapter>> #FCE4D6;line.dashed;line:999999 {
     - mountPoint : URI
     - mountCredentials : String
     + read(path : Path) : InputStream
     + write(path : Path, data : InputStream) : void
     + delete(path : Path) : void
     + exists(path : Path) : boolean
     + list(root : Path) : List<Path>
     + computeFingerprint(path : Path) : Fingerprint
     + copy(source : Path, destination : Path) : Path
     + freeSpace() : long
     - reconnect() : void
   }
   class MetadataAdapter <<secondary adapter>> {
     - ffprobePath : Path
     - exifToolPath : Path
     + supports(type : MediaType) : boolean
     + extract(path : Path) : List<MetadataEntry>
     - runProcess(cmd : List<String>) : String
   }
   class TranscodingAdapter <<secondary adapter>> {
     - ffmpegPath : Path
     - tempDirectory : Path
     + supports(source : MediaType, p : StreamProfile) : boolean
     + transcode(path : Path, p : StreamProfile, pos : Duration) : MediaStream
     - buildCommand(path : Path, p : StreamProfile, pos : Duration) : List<String>
   }
   class LocalIdentityAdapter <<secondary adapter>> {
     - dataSource : DataSource
     - hashAlgorithm : String
     + supports(c : Credentials) : boolean
     + verify(c : Credentials) : Optional<LinkedIdentity>
     + register(username : String, password : String) : LinkedIdentity
     + changePassword(i : LinkedIdentity, newPassword : String) : void
     - computeHash(password : String, salt : String) : String
     - comparePassword(plain : String, hash : String) : boolean
   }
   class OidcIdentityAdapter <<secondary adapter>> #FCE4D6;line.dashed;line:999999 {
     - issuer : URI
     - clientId : String
     + supports(c : Credentials) : boolean
     + verify(c : Credentials) : Optional<LinkedIdentity>
     - validateToken(externalToken : String) : Map<String,String>
   }
   class InMemoryTokenAdapter <<secondary adapter>> {
     - tokens : Map<String,SessionToken>
     + save(t : SessionToken) : void
     + find(value : String) : Optional<SessionToken>
     + delete(value : String) : void
     - purgeExpired() : void
   }
   class EventBusAdapter <<secondary adapter>> {
     - observers : List<ICatalogObserver>
     + publish(e : DomainEvent) : void
     + subscribe(observer : ICatalogObserver) : void
     + unsubscribe(observer : ICatalogObserver) : void
     - dispatchToObservers(e : DomainEvent) : void
   }
   class CatalogIndexMapper <<mapper>> {
     + toSnapshot(row : ResultSet, files : List<MediaFileSnapshot>, collections : List<CollectionSnapshot>) : CatalogSnapshot
     + bind(statement : PreparedStatement, i : CatalogSnapshot) : void
   }
   class MediaFileMapper <<mapper>> {
     + toSnapshot(row : ResultSet, metadata : List<MetadataEntry>, tags : Set<Tag>) : MediaFileSnapshot
     + bind(statement : PreparedStatement, i : MediaFileSnapshot) : void
   }
