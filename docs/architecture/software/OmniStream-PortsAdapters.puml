@startuml OmniStream-PortsAdapters
' ============================================================
'  OmniStream - Class diagram
'  PORTS AND ADAPTERS (3-layer hexagonal architecture)
'
'  Layers:  Presentation (primary adapters)
'          -> Domain (ports, services and model)
'          -> Infrastructure (secondary adapters)
'  The composition root is not a layer: it only creates and wires.
'
'  Conventions:
'   - Ports are domain interfaces. Driving ports are
'     implemented by the domain services; driven ports,
'     by the secondary adapters.
'   - Services are shown without members: they are in
'     OmniStream-Services.puml. The types in the signatures are
'     in that diagram (DTOs) and in OmniStream-Domain-Model.puml.
'   - "(via X)" on a dependency means it is used by an
'     internal collaborator of the service (chain step or
'     strategy), not by the service directly.
'   - The HTTP adapters use Javalin (ADR 0014); Javalin and
'     Context are types from that library.
'   - Dashed border: outside the scope of version 1.0 (ADR 0009).
' ============================================================

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam ArrowFontSize 10
skinparam PackageFontStyle bold
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members
' Packages are visual groupings only, not namespaces.
set separator none

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #666666
  FontSize 12
  AttributeFontSize 11
  BackgroundColor<<primary adapter>>   #EAF3F8
  BorderColor<<primary adapter>>       #2E86AB
  BackgroundColor<<driving port>>      #E8F5E9
  BorderColor<<driving port>>          #3E8E41
  BackgroundColor<<domain service>>    #FCE8B4
  BorderColor<<domain service>>        #B89748
  BackgroundColor<<service base>>      #ECE4F8
  BorderColor<<service base>>          #9673A6
  BackgroundColor<<observer>>          #FCF4E0
  BorderColor<<observer>>              #C4A868
  BackgroundColor<<driven port>>       #F3E5F5
  BorderColor<<driven port>>           #8E44AD
  BackgroundColor<<secondary adapter>> #FCE4D6
  BorderColor<<secondary adapter>>     #C0504D
  BackgroundColor<<decorator>>         #FDEBD0
  BorderColor<<decorator>>             #D98E04
  BackgroundColor<<mapper>>            #F7F7F7
  BorderColor<<mapper>>                #888888
  BackgroundColor<<command>>           #FCF4E0
  BorderColor<<command>>               #C4A868
  BackgroundColor<<dto>>               #FCF4E0
  BorderColor<<dto>>                   #C4A868
  BackgroundColor<<abstract factory>>  #ECE4F8
  BorderColor<<abstract factory>>      #9673A6
  BackgroundColor<<concrete factory>>  #FFFDE7
  BorderColor<<concrete factory>>      #B8A848
  BackgroundColor<<composition root>>  #FFF2CC
  BorderColor<<composition root>>      #B8860B
}
skinparam note {
  BackgroundColor #FEFFDD
  BorderColor #B8A848
  FontSize 11
}

' ============================================================
' EXTERNAL ACTOR AND PRIMARY ADAPTERS  (presentation)
' ============================================================
class "Web browser" as WebBrowser <<actor>>

package "Primary adapters (presentation)" #EAF3F8 {
   class CliAdapter <<primary adapter>> {
     - catalogManagement : ICatalogManagement
     - systemIdentity : UserId
     + execute(args : List<String>) : int
     - printHelp() : void
   }
   class WebUiAdapter <<primary adapter>> {
     - staticDirectory : Path
     + registerRoutes(config : JavalinConfig) : void
   }
   class RestApiAdapter <<primary adapter>> {
     - catalogManagement : ICatalogManagement
     - playback : IPlayback
     - search : ISearch
     - accessControl : IAccessControl
     - sync : ISync
     - auditTrail : IAuditTrail
     + registerRoutes(config : JavalinConfig) : void
     - authenticateRequest(ctx : Context) : SessionToken
     - sendStream(ctx : Context, f : MediaStream) : void
   }
   class ApiJson <<adapter helper>> {
     + {static} mapper() : JsonMapper
     + {static} forJavalin() : JavalinJackson3
   }
   class ApiErrors <<adapter helper>> {
     + {static} register(config : JavalinConfig) : void
   }
   class SchedulerAdapter <<primary adapter>> {
     - tasks : Map<String,ScheduledTask>
     - intervals : Map<String,Duration>
     - systemIdentity : UserId
     + register(every : Duration, t : ScheduledTask) : void
     + start() : void
     + stop() : void
     - fire(t : ScheduledTask) : void
   }
   interface ScheduledTask <<command>> {
     + name() : String
     + execute(executor : UserId) : void
   }
   class ReindexTask <<command>> {
     - catalogManagement : ICatalogManagement
     - root : Path
     + name() : String
     + execute(executor : UserId) : void
   }
   class BackupTask <<command>> {
     - catalogManagement : ICatalogManagement
     - destination : Path
     + name() : String
     + execute(executor : UserId) : void
   }
   class SyncTask <<command>> {
     - eventDispatch : IEventDispatch
     - limit : int
     + name() : String
     + execute(executor : UserId) : void
   }

   ScheduledTask <|.. ReindexTask
   ScheduledTask <|.. BackupTask
   ScheduledTask <|.. SyncTask
   SchedulerAdapter o-- "0..*" ScheduledTask : schedules
 }

WebBrowser --> WebUiAdapter : requests HTTP interface
WebBrowser --> RestApiAdapter : consumes HTTP/JSON API

' ============================================================
' DRIVING PORTS  (domain)
' ============================================================
package "Driving ports (domain)" #E8F5E9 {
   interface ICatalogManagement <<driving port>> {
     + ingestFile(u : UserId, path : Path) : IngestionResult
     + uploadFile(u : UserId, fileName : String, data : InputStream) : IngestionResult
     + reindexLibrary(u : UserId, root : Path) : int
     + detectDuplicates(u : UserId) : List<MediaFileSnapshot>
     + editMetadata(u : UserId, id : ItemId, key : String, value : String) : void
     + deleteFile(u : UserId, id : ItemId) : void
     + backupCatalog(admin : UserId, destination : Path) : Path
     + configureLibraryPath(admin : UserId, path : Path) : void
     + monitorServerStatus(admin : UserId) : ServerStatus
   }
   interface ISearch <<driving port>> {
     + searchContent(u : UserId, txt : String) : List<CatalogItemSnapshot>
     + filterByCriteria(u : UserId, c : SearchCriteria) : List<MediaFileSnapshot>
     + browseLibrary(u : UserId) : List<CatalogItemSnapshot>
     + browseLibrary(u : UserId, col : ItemId) : List<CatalogItemSnapshot>
     + manageCollections(u : UserId, cmd : CollectionCommand) : CollectionSnapshot
     + tagFile(u : UserId, id : ItemId, e : Tag) : void
   }
   interface IPlayback <<driving port>> {
     + openSession(u : UserId, id : ItemId) : PlaybackSessionSnapshot
     + resumeFromLastPosition(u : UserId, id : ItemId) : PlaybackSessionSnapshot
     + requestStream(u : UserId, s : SessionId, p : StreamProfile) : MediaStream
     + recordProgress(u : UserId, s : SessionId, pos : Duration) : void
     + pauseSession(u : UserId, s : SessionId) : void
     + resumeSession(u : UserId, s : SessionId) : void
     + finishSession(u : UserId, s : SessionId) : void
   }
   interface IAccessControl <<driving port>> {
     + authenticateUser(c : Credentials) : SessionToken
     + validateToken(value : String) : Optional<SessionToken>
     + logout(value : String) : void
     + accessWithLink(link : String) : SessionToken
     + authorizeResource(u : UserId, r : ItemId, acc : AccessType) : boolean
     + shareCollection(u : UserId, col : ItemId, level : PermissionLevel, lifetime : Duration) : SharedLinkSnapshot
     + createUser(admin : UserId, username : String, password : String, role : Role) : UserId
     + manageRoles(admin : UserId, target : UserId, role : Role) : void
     + grantPermission(granter : UserId, u : UserId, p : Permission) : void
     + revokePermission(granter : UserId, u : UserId, p : Permission) : void
     + deactivateUser(admin : UserId, u : UserId) : void
     + listUsers(admin : UserId) : List<UserSnapshot>
     + findUser(u : UserId, username : String) : UserId
     + accessTo(u : UserId, resource : ItemId) : List<AccessGrant>
   }
   interface ISync <<driving port>> {
     + syncChanges(u : UserId, since : Instant) : SyncDelta
     + cacheContent(u : UserId, id : ItemId) : OfflinePackage
     + hasPendingChanges(u : UserId, since : Instant) : boolean
   }
   interface IEventDispatch <<driving port>> {
     + publishPending(limit : int) : int
   }
   interface IAuditTrail <<driving port>> {
     + history(u : UserId, q : AuditQuery) : List<AuditEntry>
   }
   interface IRuleManagement <<driving port>> #E8F5E9;line.dashed;line:999999 {
     + createRule(admin : UserId, c : ClassificationCriterion) : void
     + deleteRule(admin : UserId, name : String) : void
     + listRules(admin : UserId) : List<ClassificationCriterion>
     + reclassifyLibrary(admin : UserId) : int
   }
 }

' ============================================================
' DOMAIN SERVICES  (details in the services diagram)
' ============================================================
package "Domain services (see services diagram)" #FFF8E1 {
   abstract class AuthorizedService <<service base>>
   class CatalogService <<domain service>>
   class SearchService <<domain service>>
   class PlaybackService <<domain service>>
   class AccessService <<domain service>>
   class SyncService <<domain service>>
   class EventDispatchService <<domain service>>
   class ClassificationService <<domain service>> #FCE8B4;line.dashed;line:999999
   interface ICatalogObserver <<observer>> {
     + onCatalogChanged(e : DomainEvent) : void
   }
   class SyncObserver <<observer>>
   ICatalogObserver <|.. SyncObserver
   class AuditService <<domain service>>
   abstract class AuditingDecorator <<decorator>>
   class AuditedAccessControl <<decorator>>
   class AuditedCatalogManagement <<decorator>>
   class AuditedSearch <<decorator>>
   class AuditedSync <<decorator>>
 }

 ICatalogManagement <|.. CatalogService
 ISearch <|.. SearchService
 IPlayback <|.. PlaybackService
 IAccessControl <|.. AccessService
 ISync <|.. SyncService
 IEventDispatch <|.. EventDispatchService
 IRuleManagement <|.. ClassificationService
 IAuditTrail <|.. AuditService
 IAccessControl <|.. AuditedAccessControl
 ICatalogManagement <|.. AuditedCatalogManagement
 ISearch <|.. AuditedSearch
 ISync <|.. AuditedSync
 AuditedAccessControl --> IAccessControl : delegate (AccessService)
 AuditedCatalogManagement --> ICatalogManagement : delegate (CatalogService)
 AuditedSearch --> ISearch : delegate (SearchService)
 AuditedSync --> ISync : delegate (SyncService)

 CliAdapter --> ICatalogManagement : invokes
 RestApiAdapter ..> ApiJson : configures JSON
 RestApiAdapter ..> ApiErrors : registers error responses
 RestApiAdapter --> ICatalogManagement : invokes
 RestApiAdapter --> ISearch : invokes
 RestApiAdapter --> IPlayback : invokes
 RestApiAdapter --> IAccessControl : invokes
 RestApiAdapter --> ISync : invokes
 RestApiAdapter --> IAuditTrail : invokes
 RestApiAdapter ..> IRuleManagement : invokes (2.0)
 SchedulerAdapter ..> ScheduledTask : fires
 ReindexTask --> ICatalogManagement : invokes
 BackupTask --> ICatalogManagement : invokes
 SyncTask --> IEventDispatch : invokes

' ============================================================
' DRIVEN PORTS  (domain)
' ============================================================
package "Driven ports (domain)" #F3E5F5 {
   interface ICatalogRepository <<driven port>> {
     + getCatalog() : CatalogIndex
     + save(c : CatalogIndex) : void
     + findFile(id : ItemId) : Optional<MediaFileSnapshot>
     + findByFingerprint(h : Fingerprint) : Optional<MediaFileSnapshot>
     + findByText(txt : String) : List<MediaFileSnapshot>
     + findByCriteria(c : SearchCriteria) : List<MediaFileSnapshot>
   }
   interface ISessionRepository <<driven port>> {
     + save(s : PlaybackSession) : void
     + findById(id : SessionId) : Optional<PlaybackSession>
     + findLastSession(u : UserId, a : ItemId) : Optional<PlaybackSession>
     + countActive() : int
   }
   interface IUserRepository <<driven port>> {
     + save(u : User) : void
     + findById(id : UserId) : Optional<User>
     + findByUsername(username : String) : Optional<User>
     + findByIdentity(i : LinkedIdentity) : Optional<User>
     + findAll() : List<User>
   }
   interface ISharedLinkRepository <<driven port>> {
     + save(e : SharedLink) : void
     + findByToken(token : String) : Optional<SharedLink>
   }
   interface IChangeLog <<driven port>> {
     + register(e : CatalogEvent) : void
     + changesSince(since : Instant) : SyncDelta
     + hasChangesSince(since : Instant) : boolean
   }
   interface IOutboxRepository <<driven port>> {
     + fetchPending(limit : int) : List<DomainEvent>
     + markPublished(id : EventId) : void
   }
   interface IUnitOfWork <<driven port>> {
     + execute(work : Supplier<T>) : T
   }
   interface IAuditLog <<driven port>> {
     + append(e : AuditEntry) : void
     + find(q : AuditQuery) : List<AuditEntry>
   }
   interface ITokenRepository <<driven port>> {
     + save(t : SessionToken) : void
     + find(value : String) : Optional<SessionToken>
     + delete(value : String) : void
   }
   interface IFileStorage <<driven port>> {
     + read(path : Path) : InputStream
     + write(path : Path, data : InputStream) : void
     + delete(path : Path) : void
     + exists(path : Path) : boolean
     + list(root : Path) : List<Path>
     + computeFingerprint(path : Path) : Fingerprint
     + copy(source : Path, destination : Path) : Path
     + freeSpace() : long
   }
   interface IMetadataExtractor <<driven port>> {
     + supports(type : MediaType) : boolean
     + extract(path : Path) : List<MetadataEntry>
   }
   interface ITranscoder <<driven port>> {
     + supports(source : MediaType, p : StreamProfile) : boolean
     + transcode(path : Path, p : StreamProfile, pos : Duration) : MediaStream
   }
   interface IIdentityProvider <<driven port>> {
     + supports(c : Credentials) : boolean
     + verify(c : Credentials) : Optional<LinkedIdentity>
   }
   interface ICredentialRegistry <<driven port>> {
     + register(username : String, password : String) : LinkedIdentity
     + changePassword(i : LinkedIdentity, newPassword : String) : void
   }
   interface IDataBackup <<driven port>> {
     + backup(destination : Path) : Path
   }
   interface IConfigurationRepository <<driven port>> {
     + getLibraryPath() : Path
     + saveLibraryPath(path : Path) : void
   }
   interface IRuleRepository <<driven port>> #F3E5F5;line.dashed;line:999999 {
     + findAll() : List<ClassificationCriterion>
     + save(c : ClassificationCriterion) : void
     + delete(name : String) : void
   }
   interface IEventPublisher <<driven port>> {
     + publish(e : DomainEvent) : void
   }
   interface IEventSubscriber <<driven port>> {
     + subscribe(observer : ICatalogObserver) : void
     + unsubscribe(observer : ICatalogObserver) : void
   }
   interface IEventBus <<driven port>>
   IEventBus --|> IEventPublisher
   IEventBus --|> IEventSubscriber
 }

 AuthorizedService ..> IUserRepository : loads user to authorize
 CatalogService ..> ICatalogRepository : queries / persists
 CatalogService ..> ISessionRepository : counts active sessions
 CatalogService ..> IFileStorage : reads / writes
 CatalogService ..> IDataBackup : backs up the database
 CatalogService ..> IConfigurationRepository : saves the library path
 CatalogService ..> IMetadataExtractor : extracts (via ExtractionStep)
 SearchService ..> ICatalogRepository : queries / persists
 PlaybackService ..> ISessionRepository : persists sessions
 PlaybackService ..> ICatalogRepository : finds the file
 PlaybackService ..> IFileStorage : direct stream (via DirectStream)
 PlaybackService ..> ITranscoder : transcodes (via TranscodedStream)
 AccessService ..> IIdentityProvider : verifies identity (Strategy)
 AccessService ..> ICredentialRegistry : registers local password
 AccessService ..> ITokenRepository : saves / validates tokens
 AccessService ..> ISharedLinkRepository : saves / finds links
 AccessService ..> IUnitOfWork : wraps transaction
AccessService ..> ICatalogRepository : reads collections for inherited access
 SyncService ..> IChangeLog : reads changes
 SyncService ..> ICatalogRepository : builds packages
 SyncService ..> IFileStorage : reads content
 SyncObserver ..> IChangeLog : records changes
 EventDispatchService ..> IOutboxRepository : fetches and marks pending
 EventDispatchService ..> IEventPublisher : publishes events
 ClassificationService ..> IRuleRepository : reads / saves rules
 ClassificationService ..> ICatalogRepository : reclassifies the catalog
 AuditService ..> IAuditLog : reads the trail
 AuditingDecorator ..> IAuditLog : appends entries
 AuditingDecorator ..> IUnitOfWork : change and entry together
 AuditedAccessControl ..> IUserRepository : names failed logins
 AuditedCatalogManagement ..> ICatalogRepository : keeps deleted file names
 IEventSubscriber ..> ICatalogObserver : registers

