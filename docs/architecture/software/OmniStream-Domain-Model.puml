@startuml OmniStream-Domain-Model
' ============================================================
'  OmniStream - Class diagram
'  DOMAIN layer, MODEL view (entities, rules and events)
'  Module: omnistream-domain
'
'  Scope: the model only. Domain services are in
'  OmniStream-Services.puml and ports in
'  OmniStream-PortsAdapters.puml.
'
'  Rules applied:
'   - One package per aggregate; references between aggregates
'     are BY IDENTIFIER, never by object.
'   - Value objects are immutable and have no identity.
'   - No getters/setters: every method expresses a rule.
'   - Every change to the catalog goes through its root, which records
'     the corresponding domain event.
'   - State leaves the domain only as immutable snapshots
'     (Memento, ADR 0011). Methods that timestamp something receive
'     the instant (now) from the service's clock.
'   - Zero dependencies on frameworks, persistence or HTTP.
'   - Dashed border: outside the scope of version 1.0 (ADR 0009).
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam ArrowColor #666666
skinparam ArrowFontSize 11
skinparam PackageFontStyle bold
skinparam nodesep 25
skinparam ranksep 55
' Packages are visual groupings only, not namespaces.
set separator none

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #666666
  FontSize 12
  AttributeFontSize 11
  BackgroundColor<<aggregate root>> #FFE8B5
  BorderColor<<aggregate root>>     #B8860B
  BackgroundColor<<entity>>         #FFF7E0
  BorderColor<<entity>>             #C9A227
  BackgroundColor<<value object>>   #E8F4FD
  BorderColor<<value object>>       #2E86AB
  BackgroundColor<<abstract>>       #F0E6FA
  BorderColor<<abstract>>           #8E44AD
  BackgroundColor<<policy>>         #E6F6E6
  BorderColor<<policy>>             #3E8E41
  BackgroundColor<<event>>          #ECE4F8
  BorderColor<<event>>              #9673A6
  BackgroundColor<<snapshot>>       #EEF7F1
  BorderColor<<snapshot>>           #5B9A70
  BackgroundColor<<exception>>      #FBE9E7
  BorderColor<<exception>>          #C0504D
}
skinparam enum {
  BackgroundColor #F7F7F7
  BorderColor #888888
  FontSize 11
}
skinparam package {
  BackgroundColor #FCFCFC
  BorderColor #AAAAAA
}

' ============================================================
' CATALOG AGGREGATE     root: CatalogIndex
' ============================================================
package "Catalog aggregate" {

  class CatalogIndex <<aggregate root>> {
    - id : CatalogId
    - name : String
    - files : Map<Fingerprint, MediaFile>
    - collections : List<Collection>
    - events : List<CatalogEvent>
    - version : long
    __
    + ingest(file : MediaFile, now : Instant) : IngestionResult
    + findByFingerprint(h : Fingerprint) : Optional<MediaFile>
    + findItem(id : ItemId) : Optional<CatalogItem>
    + hasDuplicate(h : Fingerprint) : boolean
    + editMetadata(id : ItemId, m : MetadataEntry, now : Instant) : void
    + tag(id : ItemId, e : Tag, now : Instant) : void
    + applyClassification(id : ItemId, c : Classification, now : Instant) : void
    + delete(id : ItemId, now : Instant) : void
    + createCollection(name : String, now : Instant) : Collection
    + addToCollection(collection : ItemId, item : ItemId, now : Instant) : void
    + totalFiles() : int
    + pullEvents() : List<CatalogEvent>
    + toSnapshot() : CatalogSnapshot
    + {static} fromSnapshot(i : CatalogSnapshot) : CatalogIndex
    - register(e : CatalogEvent) : void
  }

  abstract class CatalogItem <<abstract>> {
    # id : ItemId
    # name : String
    __
    + {abstract} totalSize() : long
    + {abstract} countFiles() : int
    + {abstract} contains(e : CatalogItem) : boolean
    + {abstract} toSnapshot() : CatalogItemSnapshot
    + rename(name : String) : void
  }

  class MediaFile <<entity>> {
    - path : Path
    - fingerprint : Fingerprint
    - type : MediaType
    - sizeBytes : long
    - duration : Duration
    - status : IndexingStatus
    - ingestedAt : Instant
    __
    + {static} create(name : String, path : Path, fingerprint : Fingerprint, type : MediaType, sizeBytes : long, duration : Duration, now : Instant) : MediaFile
    + isDuplicateOf(other : MediaFile) : boolean
    + addMetadata(m : MetadataEntry) : void
    + metadataEntry(key : String) : Optional<MetadataEntry>
    + tag(e : Tag) : void
    + replaceAutomaticTags(newTags : Set<Tag>) : void
    + markIndexed() : void
    + markFailed(cause : String) : void
    + totalSize() : long
    + countFiles() : int
    + contains(e : CatalogItem) : boolean
    + toSnapshot() : MediaFileSnapshot
  }

  class Collection <<entity>> {
    - description : String
    __
    + add(e : CatalogItem) : void
    + remove(e : CatalogItem) : void
    + totalSize() : long
    + countFiles() : int
    + contains(e : CatalogItem) : boolean
    + depth() : int
    + toSnapshot() : CollectionSnapshot
    - wouldCreateCycle(e : CatalogItem) : boolean
  }

  class MetadataEntry <<value object>> {
    - key : String
    - value : String
    - source : MetadataSource
    __
    + isManual() : boolean
    + withValue(v : String) : MetadataEntry
  }

  class Fingerprint <<value object>> {
    - algorithm : String
    - value : String
    __
    + matches(other : Fingerprint) : boolean
  }

  class Tag <<value object>> {
    - name : String
    - source : TagSource
    __
    + normalized() : String
    + isAutomatic() : boolean
  }

  class IngestionResult <<value object>> {
    - fileId : ItemId
    - duplicate : boolean
    - action : DuplicateAction
    __
    + wasIndexed() : boolean
  }

  class CatalogId <<value object>> {
    - value : UUID
  }

  class ItemId <<value object>> {
    - value : UUID
  }
}

' ============================================================
' ACCESS AGGREGATE      root: User
' ============================================================
package "Access aggregate" {

  class User <<aggregate root>> {
    - id : UserId
    - username : String
    - role : Role
    - permissions : Set<Permission>
    - identities : Set<LinkedIdentity>
    - active : boolean
    __
    + {static} create(username : String, role : Role, i : LinkedIdentity) : User
    + {static} createGuest(resource : ItemId, level : PermissionLevel) : User
    + canAccess(resource : ItemId, access : AccessType) : boolean
    + grant(p : Permission) : void
    + revoke(p : Permission) : void
    + changeRole(r : Role) : void
    + link(i : LinkedIdentity) : void
    + isAdmin() : boolean
    + deactivate() : void
    + toSnapshot() : UserSnapshot
    + {static} fromSnapshot(i : UserSnapshot) : User
  }

  class Permission <<value object>> {
    - resource : ItemId
    - level : PermissionLevel
    __
    + allows(access : AccessType) : boolean
    + appliesTo(resource : ItemId) : boolean
  }

  class LinkedIdentity <<value object>> {
    - issuer : String
    - subject : String
    __
    + isLocal() : boolean
  }

  class UserId <<value object>> {
    - value : UUID
  }
}

' ============================================================
' SHARED LINK AGGREGATE   root: SharedLink
' ============================================================
package "Shared link aggregate" {

  class SharedLink <<aggregate root>> {
    - id : SharedLinkId
    - token : String
    - collectionId : ItemId
    - guestId : UserId
    - level : PermissionLevel
    - createdBy : UserId
    - expiresAt : Instant
    - revoked : boolean
    __
    + {static} create(collection : ItemId, guest : UserId, level : PermissionLevel, createdBy : UserId, lifetime : Duration, now : Instant) : SharedLink
    + isValidAt(now : Instant) : boolean
    + revoke() : void
    + toSnapshot() : SharedLinkSnapshot
    + {static} fromSnapshot(i : SharedLinkSnapshot) : SharedLink
  }

  class SharedLinkId <<value object>> {
    - value : UUID
  }
}

' ============================================================
' PLAYBACK AGGREGATE    root: PlaybackSession
' ============================================================
package "Playback aggregate" {

  class PlaybackSession <<aggregate root>> {
    - id : SessionId
    - fileId : ItemId
    - userId : UserId
    - position : Duration
    - totalDuration : Duration
    - status : SessionStatus
    - startedAt : Instant
    __
    + {static} start(fileId : ItemId, userId : UserId, totalDuration : Duration, now : Instant) : PlaybackSession
    + advance(delta : Duration) : void
    + pause() : void
    + resume() : void
    + finish() : void
    + isCompleted() : boolean
    + canResume() : boolean
    + percentWatched() : double
    + toSnapshot() : PlaybackSessionSnapshot
    + {static} fromSnapshot(i : PlaybackSessionSnapshot) : PlaybackSession
  }

  class SessionId <<value object>> {
    - value : UUID
  }
}

' ============================================================
' AUTOMATIC CLASSIFICATION   (ADR 0016)
' ============================================================
package "Automatic classification" {

  class Classification <<value object>> {
    - tags : Set<Tag>
    - collections : Set<ItemId>
    __
    + {static} empty() : Classification
    + combine(other : Classification) : Classification
    + isEmpty() : boolean
  }

  class ClassificationCriterion <<value object>> #E8F4FD;line.dashed;line:999999 {
    - name : String
    - field : String
    - operator : RuleOperator
    - value : String
    - tag : Tag
    - collection : Optional<ItemId>
    __
    + matches(a : MediaFileSnapshot) : boolean
    + result() : Classification
  }
}

' ============================================================
' DOMAIN EVENTS
' ============================================================
package "Domain events" {

  abstract class DomainEvent <<event>> {
    - id : EventId
    - occurredAt : Instant
    __
    + type() : String
  }

  abstract class CatalogEvent <<event>> {
    - itemId : ItemId
    __
    + item() : ItemId
    + {abstract} changeType() : ChangeType
  }

  class FileIngested <<event>> {
    + changeType() : ChangeType
  }
  class FileModified <<event>> {
    + changeType() : ChangeType
  }
  class FileDeleted <<event>> {
    + changeType() : ChangeType
  }
  class CollectionCreated <<event>> {
    + changeType() : ChangeType
  }
  class CollectionModified <<event>> {
    + changeType() : ChangeType
  }
  class FileClassified <<event>> {
    + changeType() : ChangeType
  }

  class EventId <<value object>> {
    - value : UUID
  }
}

' ============================================================
' SNAPSHOTS   (Memento: immutable state of each aggregate)
' ============================================================
package "Snapshots (Memento)" {

  class CatalogSnapshot <<snapshot>> {
    + id : CatalogId
    + name : String
    + version : long
    + files : List<MediaFileSnapshot>
    + collections : List<CollectionSnapshot>
  }

  interface CatalogItemSnapshot <<snapshot>> {
    + id() : ItemId
    + name() : String
  }

  class MediaFileSnapshot <<snapshot>> {
    + id : ItemId
    + name : String
    + path : Path
    + fingerprint : Fingerprint
    + type : MediaType
    + sizeBytes : long
    + duration : Duration
    + status : IndexingStatus
    + ingestedAt : Instant
    + metadata : List<MetadataEntry>
    + tags : Set<Tag>
  }

  class CollectionSnapshot <<snapshot>> {
    + id : ItemId
    + name : String
    + description : String
    + items : List<ItemId>
  }

  class UserSnapshot <<snapshot>> {
    + id : UserId
    + username : String
    + role : Role
    + permissions : Set<Permission>
    + identities : Set<LinkedIdentity>
    + active : boolean
  }

  class SharedLinkSnapshot <<snapshot>> {
    + id : SharedLinkId
    + token : String
    + collectionId : ItemId
    + guestId : UserId
    + level : PermissionLevel
    + createdBy : UserId
    + expiresAt : Instant
    + revoked : boolean
  }

  class PlaybackSessionSnapshot <<snapshot>> {
    + id : SessionId
    + fileId : ItemId
    + userId : UserId
    + position : Duration
    + totalDuration : Duration
    + status : SessionStatus
    + startedAt : Instant
  }
}

' ============================================================
' DOMAIN EXCEPTIONS
' ============================================================
package "Domain exceptions" {
  abstract class DomainException <<exception>>
  class AccessDenied <<exception>>
  class ResourceNotFound <<exception>>
  class InvalidCredentials <<exception>>
  class ExpiredLink <<exception>>
  class CyclicCollection <<exception>>
  class FileRejected <<exception>>
  class VersionConflict <<exception>>
}

' ============================================================
' DOMAIN POLICIES   (stateless rules)
' ============================================================
package "Domain policies" {

  class DeduplicationPolicy <<policy>> {
    + isDuplicate(a : MediaFile, c : CatalogIndex) : boolean
    + resolve(incoming : MediaFile, existing : MediaFile) : DuplicateAction
  }

  class AccessPolicy <<policy>> {
    + authorizes(u : User, resource : ItemId, access : AccessType) : boolean
    + effectiveLevel(u : User, resource : ItemId) : PermissionLevel
  }
}

' ============================================================
' ENUMERATIONS
' ============================================================
package "Enumerations" {
  enum MediaType {
    VIDEO
    AUDIO
    IMAGE
    DOCUMENT
  }
  enum IndexingStatus {
    PENDING
    INDEXING
    INDEXED
    ERROR
  }
  enum MetadataSource {
    EXTRACTED
    MANUAL
  }
  enum TagSource {
    AUTOMATIC
    MANUAL
  }
  enum RuleOperator #F7F7F7;line.dashed;line:999999 {
    EQUALS
    CONTAINS
    GREATER_THAN
    LESS_THAN
  }
  enum Role {
    ADMIN
    USER
    GUEST
  }
  enum PermissionLevel {
    READ
    WRITE
    MANAGE
  }
  enum AccessType {
    VIEW
    DOWNLOAD
    MODIFY
    DELETE
  }
  enum SessionStatus {
    ACTIVE
    PAUSED
    FINISHED
  }
  enum DuplicateAction {
    REJECT
    REPLACE
    KEEP_BOTH
  }
  enum ChangeType {
    ADDED
    MODIFIED
    REMOVED
  }
}

' ============================================================
' RELATIONS  -  CATALOG AGGREGATE
' ============================================================

' The root owns the files: deleting the catalog deletes them
CatalogIndex "1" *-- "0..*" MediaFile : indexes >
CatalogIndex "1" *-- "0..*" Collection         : organizes >
CatalogIndex "1" *-- "1"    CatalogId        : id >
CatalogIndex ..> IngestionResult : produces

' COMPOSITE: the collection groups items that exist on their own
CatalogItem <|-- MediaFile
CatalogItem <|-- Collection
Collection "1" o-- "0..*" CatalogItem : items >

' The file owns its metadata, fingerprint and tags
MediaFile "1" *-- "0..*" MetadataEntry  : metadata >
MediaFile "1" *-- "1"    Fingerprint : fingerprint >
MediaFile "1" *-- "0..*" Tag  : tags >

CatalogItem "1" *-- "1" ItemId : id >

' ============================================================
' RELATIONS  -  ACCESS AGGREGATE
' ============================================================
User "1" *-- "0..*" Permission   : permissions >
User "1" *-- "1..*" LinkedIdentity : identities >
User "1" *-- "1"    UserId : id >

' ============================================================
' RELATIONS  -  SHARED LINK AGGREGATE
' ============================================================
SharedLink "1" *-- "1" SharedLinkId : id >

' ============================================================
' RELATIONS  -  PLAYBACK AGGREGATE
' ============================================================
PlaybackSession "1" *-- "1" SessionId : id >

' ============================================================
' REFERENCES BETWEEN AGGREGATES  -  ALWAYS BY IDENTIFIER
' ============================================================
PlaybackSession ..> ItemId : <<by id>>\nplays
PlaybackSession ..> UserId  : <<by id>>\nbelongs to
SharedLink   ..> ItemId : <<by id>>\nshares
SharedLink   ..> UserId  : <<by id>>\nguest and creator

' ============================================================
' RELATIONS  -  EVENTS
' ============================================================
DomainEvent <|-- CatalogEvent
CatalogEvent <|-- FileIngested
CatalogEvent <|-- FileModified
CatalogEvent <|-- FileDeleted
CatalogEvent <|-- CollectionCreated
CatalogEvent <|-- CollectionModified
CatalogEvent <|-- FileClassified
DomainEvent "1" *-- "1" EventId : id >
CatalogIndex "1" o-- "0..*" CatalogEvent : records >

' ============================================================
' RELATIONS  -  AUTOMATIC CLASSIFICATION
' ============================================================
Classification "1" o-- "0..*" Tag : tags >
CatalogIndex ..> Classification : applies
ClassificationCriterion ..> Classification : produces

' ============================================================
' RELATIONS  -  SNAPSHOTS (Memento)
' ============================================================
CatalogItemSnapshot <|.. MediaFileSnapshot
CatalogItemSnapshot <|.. CollectionSnapshot
CatalogSnapshot "1" *-- "0..*" MediaFileSnapshot : files >
CatalogSnapshot "1" *-- "0..*" CollectionSnapshot : collections >
CatalogIndex     ..> CatalogSnapshot : <<memento>>
User            ..> UserSnapshot  : <<memento>>
SharedLink   ..> SharedLinkSnapshot   : <<memento>>
PlaybackSession ..> PlaybackSessionSnapshot   : <<memento>>

' ============================================================
' RELATIONS  -  EXCEPTIONS
' ============================================================
DomainException <|-- AccessDenied
DomainException <|-- ResourceNotFound
DomainException <|-- InvalidCredentials
DomainException <|-- ExpiredLink
DomainException <|-- CyclicCollection
DomainException <|-- FileRejected
DomainException <|-- VersionConflict

' ============================================================
' POLICIES
' ============================================================
DeduplicationPolicy ..> CatalogIndex : evaluates
AccessPolicy        ..> User        : evaluates

' ============================================================
' DESIGN NOTES
' ============================================================
note top of CatalogItem
  **Composite pattern**
  MediaFile is the leaf and Collection the composite.
  totalSize(), countFiles() and contains() are resolved
  recursively over the tree; the leaf ends the recursion.
  Collections can be nested inside collections.
end note

note right of Collection
  wouldCreateCycle() walks the descendants before
  adding: a collection cannot contain itself
  or any of its ancestors. Composite invariant.
end note

note bottom of PlaybackSession
  Separate aggregate: it references the file and the user
  **by identifier**, never by object, so each aggregate
  is loaded and persisted independently.
end note

note bottom of SharedLink
  Sharing a collection creates a guest User
  (User.createGuest) with permission on it, and a
  link that points to that guest. Whoever uses the
  link gets a token for that user, so authorization
  works exactly as for any other user.
end note

note bottom of CatalogEvent
  Every CatalogIndex method that changes the catalog
  records an event. Inside save(), the persistence adapter
  writes the aggregate and pullEvents() to the outbox
  in the same transaction.
  changeType() tells the change log whether the item
  was added, modified or removed.
end note

note bottom of DeduplicationPolicy
  Stateless rules, kept apart from the entities because
  they need to see several objects at once.
  Rules that fit in a single entity live in it
  (e.g. isDuplicateOf, canResume).
end note

note top of CatalogSnapshot
  **Memento pattern (ADR 0011)**
  The aggregate is the originator: toSnapshot() hands over its
  state and fromSnapshot() rebuilds it without validating or
  recording events. The snapshot is the memento and the
  repository the caretaker. They are immutable records used by
  the mappers, by the driving ports to respond and
  by the services to read state. Nobody changes an entity
  through them.
  version enables optimistic locking: save() fails with
  VersionConflict if someone else changed it first.
end note

note bottom of Classification
  Result of the classification rules (ADR 0016).
  applyClassification() replaces only the file's
  AUTOMATIC tags and adds it to the given
  collections; MANUAL tags are left untouched.
  Records FileClassified.
  ClassificationCriterion is a rule defined by the
  administrator (version 2.0).
end note

note bottom of DomainException
  Extends RuntimeException. The REST API adapter
  translates each one into an HTTP status code (mapError).
end note

note bottom of LinkedIdentity
  (issuer, subject) by which an identity provider
  recognizes the user: "local" + username, or
  the OIDC issuer + its "sub". The password never enters
  the domain: the local identity adapter stores it.
end note

@enduml
