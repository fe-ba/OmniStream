<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>co.omnistream</groupId>
    <artifactId>omnistream</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>omnistream-bootstrap</artifactId>
  <name>OmniStream Bootstrap</name>
  <description>Composition root, infrastructure factories and configuration</description>

  <dependencies>
    <dependency>
      <groupId>co.omnistream</groupId>
      <artifactId>omnistream-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>co.omnistream</groupId>
      <artifactId>omnistream-infrastructure</artifactId>
    </dependency>
    <dependency>
      <groupId>co.omnistream</groupId>
      <artifactId>omnistream-presentation</artifactId>
    </dependency>
    <!-- The composition root creates and starts the HTTP server (ADR 0013) -->
    <dependency>
      <groupId>io.javalin</groupId>
      <artifactId>javalin</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- The only module that knows the logging provider (ADR 0021) -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        "./mvnw package" also builds target/omnistream.jar: the application and every library
        it needs in one file, started with "java -jar omnistream.jar". Jetty, SLF4J and the
        JDBC drivers find their implementations through META-INF/services, so those files are
        merged instead of overwritten; the signatures of signed libraries no longer match the
        merged jar, so they are left out.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>omnistream</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>co.omnistream.bootstrap.Main</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
