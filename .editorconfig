# Editor settings shared by the team (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java: Google Java Style, enforced by Spotless (google-java-format)
[*.java]
max_line_length = 100

[*.{cmd,bat}]
end_of_line = crlf

# Two trailing spaces are a line break in Markdown
[*.md]
trim_trailing_whitespace = false

# The poster sources use tabs
[*.{tex,bib}]
indent_style = tab
