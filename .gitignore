# =====================================================================
# Poster (docs/architecture/empresarial)
# =====================================================================

# Build directory: auxiliary files, hook PDF and the .svg diagrams
# converted to PDF (build/svg/). All of it can be regenerated.
# Also covers Gradle's build/ output in src/.
build/

# LaTeX / LuaLaTeX auxiliary files
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.xdv
*.luac
*.pytxcode

# biblatex / biber
*.bcf
*.bbl
*.blg
*.run.xml
*-SAVE-ERROR

# Only .svg diagrams are versioned; their PDFs are regenerated in build/svg/
docs/architecture/empresarial/imgs/**/*.pdf

# Leftovers from the professor's original template ZIP
poster - copia.pdf
poster.pdf
docs/architecture/empresarial/imgs/modelo/modelo.rar

# Modeling tool backups and temp files (draw.io, Archi)
*.bkp
*.bak
*.dtmp

# =====================================================================
# Java (src/)
# =====================================================================

# Compiled classes and packages
*.class
*.jar
*.war
*.ear
*.nar

# JVM crash logs
hs_err_pid*
replay_pid*

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar

# Gradle (build/ is already ignored above)
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# Local configuration and secrets
.env
*.env.local

# =====================================================================
# IDEs and editors
# =====================================================================

# IntelliJ IDEA
.idea/
*.iml
out/

# Eclipse
.classpath
.project
.settings/

# NetBeans
nbproject/private/

# VS Code
.vscode/

# Vim / Neovim
*.swp
*.swo
*~

# =====================================================================
# Operating system
# =====================================================================
.DS_Store
Thumbs.db
desktop.ini
